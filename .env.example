# ==============================================================================
# CloudWABA - WhatsApp Business API SaaS Environment Configuration
# ==============================================================================

# --- GENERAL & APPLET CONFIGURATION ---
# App public URL (AI Studio automatically injects this at runtime)
APP_URL="https://your-domain-or-cloudrun-url.app"
PORT=3000

# --- FIREBASE CONFIGURATION (Loaded from firebase-applet-config.json) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Optional: Firebase Admin Service Account (for server-side privileged tasks if used)
# FIREBASE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",...}"

# --- META DEVELOPER APPLICATION CONFIGURATION ---
# 1. Create an app at https://developers.facebook.com/
# 2. Select "Business" app type and add "WhatsApp" product.
# 3. Obtain App ID and App Secret from App Settings > Basic.
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v22.0"

# Meta WhatsApp Embedded Signup Configuration:
# Add your App URL to "Valid OAuth Redirect URIs" and "Website URL" in Meta App settings.
VITE_META_APP_ID=""
VITE_META_CONFIG_ID=""

# Permanent System User Access Token (with whatsapp_business_messaging and whatsapp_business_management permissions)
# OR generated during Meta Embedded Signup exchange
META_SYSTEM_USER_ACCESS_TOKEN=""

# --- META WEBHOOK CONFIGURATION ---
# Set the Callback URL in Meta App Dashboard > WhatsApp > Configuration to:
# {APP_URL}/api/meta/webhook
# Enter this same verify token in Meta Webhook configuration:
META_WEBHOOK_VERIFY_TOKEN=""

# Meta App Secret for verifying X-Hub-Signature-256 on incoming webhook payloads
META_APP_SECRET=""
