rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Connection testing endpoint for healthchecks
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Organizations Collection and all Subcollections
    match /organizations/{orgId} {
      allow read, write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}
